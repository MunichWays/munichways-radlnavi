{
  "dashboard": {
    "displayName": "RadNavi - Betrieb und Ressourcen",
    "gridLayout": {
      "columns": "2",
      "widgets": [
        {
          "title": "RadNavi Betrieb und Kosten",
          "text": {
            "format": "MARKDOWN",
            "content": "[Kostenbericht](https://console.cloud.google.com/billing?project=munichways-radlnavi-prod) | [Fehlerlogs](https://console.cloud.google.com/logs/query?project=munichways-radlnavi-prod) | [Alarme](https://console.cloud.google.com/monitoring/alerting?project=munichways-radlnavi-prod)\n\nKostenindikatoren sind keine Euro-Abrechnung. Echte Kosten und Budgets stehen in Cloud Billing. Speicher/CPU: Maximum pro Dienst; Latenz: hoechster Revisions-p95. Scale-to-zero kann Messluecken verursachen. Bestehende Uptime-Pruefungen bleiben aktiv."
          }
        },
        {
          "title": "Anfragen / Sekunde",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "resource.type=\"cloud_run_revision\" AND resource.labels.service_name=starts_with(\"munichways-radlnavi-\") AND metric.type=\"run.googleapis.com/request_count\"",
                    "aggregation": {
                      "alignmentPeriod": "300s",
                      "perSeriesAligner": "ALIGN_RATE",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": [
                        "resource.labels.service_name"
                      ]
                    }
                  },
                  "unitOverride": "1/s"
                },
                "plotType": "LINE"
              }
            ],
            "timeshiftDuration": "0s",
            "yAxis": {
              "scale": "LINEAR"
            }
          }
        },
        {
          "title": "HTTP 5xx / 5 Minuten",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "resource.type=\"cloud_run_revision\" AND resource.labels.service_name=starts_with(\"munichways-radlnavi-\") AND metric.type=\"run.googleapis.com/request_count\" AND metric.labels.response_code_class=\"5xx\"",
                    "aggregation": {
                      "alignmentPeriod": "300s",
                      "perSeriesAligner": "ALIGN_SUM",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": [
                        "resource.labels.service_name"
                      ]
                    }
                  },
                  "unitOverride": "1"
                },
                "plotType": "LINE"
              }
            ],
            "timeshiftDuration": "0s",
            "yAxis": {
              "scale": "LINEAR"
            }
          }
        },
        {
          "title": "Antwortzeit p95 (ms)",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "resource.type=\"cloud_run_revision\" AND resource.labels.service_name=starts_with(\"munichways-radlnavi-\") AND metric.type=\"run.googleapis.com/request_latencies\"",
                    "aggregation": {
                      "alignmentPeriod": "300s",
                      "perSeriesAligner": "ALIGN_PERCENTILE_95",
                      "crossSeriesReducer": "REDUCE_MAX",
                      "groupByFields": [
                        "resource.labels.service_name"
                      ]
                    }
